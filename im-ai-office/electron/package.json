{
  "name": "@imai/electron",
  "version": "0.0.0",
  "private": true,
  "main": "entry.js",
  "scripts": {
    "build": "node build.mjs",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "build": {
    "appId": "im.imai.office",
    "productName": "IMAI办公助手",
    "directories": {
      "output": "release",
      "buildResources": "icons"
    },
    "files": [
      "entry.js",
      "dist/**"
    ],
    "extraResources": [
      {
        "from": "../backend-ts/dist",
        "to": "backend/dist"
      },
      {
        "from": "../web",
        "to": "backend/web"
      },
      {
        "from": "../.env",
        "to": "backend/.env"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
