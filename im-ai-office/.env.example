# ===== 基础 =====
DATABASE_URL=postgresql://imai:imai_secret@localhost:5432/imai
REDIS_URL=redis://localhost:6379
AUTH_TOKEN=change_me_openim_callback_secret

# ===== LLM provider（MVP 用云端，之后切本地只改这里）=====
# 兼容 OpenAI 协议即可；本地部署时把 LLM_BASE 指向本地端点、换 LLM_MODEL
LLM_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o-mini

# ===== 可选：服务端口 =====
OIM_WEBHOOK_PORT=8100
AI_AGENT_PORT=8200
BOARD_API_PORT=8300

# ===== OpenIM 实时链路 =====
OPENIM_SECRET=openIM123
GW_LOGIN_USER=user001
