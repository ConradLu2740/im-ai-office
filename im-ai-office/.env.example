# ===== IMAI 环境变量示例（TS 栈；Python/OpenIM 时代残留已清理）=====
# 复制为 monorepo 根目录的 .env 使用。团队部署完整说明见 docs/TEAM-DEPLOY.md

# ---- 必填 ----
# PostgreSQL 连接（业务 + 聊天同一个库）
DATABASE_URL=postgresql://imai:<强口令>@127.0.0.1:5432/imai
# LLM（OpenAI 兼容协议；默认 DeepSeek，可切本地端点）
LLM_API_KEY=

# ---- 可选（均有默认值）----
# LLM_BASE=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# IMAI_LLM_RETRIES=2

# 服务端口（默认 8000；被占用时换一个，注意前端 API_BASE 对 8000 有特例，见 TEAM-DEPLOY §6）
# IMAI_TS_PORT=8000

# ---- 提醒调度 ----
# 调度线程间隔秒数（默认 60；设 0 完全关闭）
# IMAI_REMIND_INTERVAL_SEC=60
# 是否回写群消息（默认 0 关，防骚扰）
# IMAI_REMIND_TO_GROUP=0
# 每日汇总兜底推送时间（默认 18:00）与兜底管理员
# IMAI_DIGEST_TIME=18:00
# IMAI_DIGEST_ADMIN=user001

# 确定性 msgId 去重窗口（秒，默认 1800）
# IMAI_DEDUP_WINDOW_SEC=1800

# ---- 认证（无需配置）----
# 登录走 per-user scrypt 口令 + session token；账号用 CLI 建：
#   cd backend-ts && npx tsx scripts/set-password.mts <username> <password> [user_id] ["显示名"]
# 管理端点 = 登录 + group_admin 角色（role 表），无全局令牌 env。
