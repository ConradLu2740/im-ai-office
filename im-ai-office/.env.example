# ===== 基础 =====
# 宿主机运行用 127.0.0.1/localhost；容器内部署由 docker-compose 注入，勿在容器场景读本文件
DATABASE_URL=postgresql://imai:imai_secret@127.0.0.1:5432/imai
# 注意：Python 端读取的是 IMAI_REDIS_URL（imai/config.py），不是 REDIS_URL
IMAI_REDIS_URL=redis://127.0.0.1:6379/0
AUTH_TOKEN=change_me_openim_callback_secret

# ---- AI 模式（2026-08-28 决策：默认 sync 保持不变，async 观察期未满）----
# async = 事件化+后台消费（入队即回，体验更顺，但多一个 Redis 依赖）；
# 稳定观察满意后可翻默认值（imai/config.py 的 AI_MODE）
# IMAI_AI_MODE=async

# ===== LLM provider（MVP 用云端，之后切本地只改这里）=====
# 兼容 OpenAI 协议即可；本地部署时把 LLM_BASE 指向本地端点、换 LLM_MODEL
LLM_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o-mini

# ===== 可选：服务端口 =====
OIM_WEBHOOK_PORT=8100
AI_AGENT_PORT=8200
BOARD_API_PORT=8300

# ===== OpenIM 实时链路 =====
OPENIM_SECRET=openIM123
GW_LOGIN_USER=user001

# ---- LLM 调用重试（迭代2；瞬时空响应/网络错误自动重试）----
# 总尝试 = 1 + N（默认 N=2，指数退避 0.5s 起）；4xx(非408/429) 不重试
# IMAI_LLM_RETRIES=2

# ---- Step4 认证加固（均可选；未设置时保持无鉴权旧行为并打 WARN）----
# 管理令牌：/api/role/set、审批决定需带 X-IMAI-Admin-Token 头
# 生成: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
# IMAI_ADMIN_TOKEN=
# 登录共享口令：/openim/login 需带 password 字段
# IMAI_LOGIN_PASSWORD=
# CORS 白名单（逗号分隔；默认含桌面端与本地开发源）
# IMAI_ALLOWED_ORIGINS=tauri://localhost,https://tauri.localhost,http://localhost:1420
# 回调鉴权：/callback 需带 X-IMAI-Token 头（与 oim-webhook 鉴权同源复用）
# AUTH_TOKEN=
