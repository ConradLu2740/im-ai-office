{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IMAI办公助手",
  "version": "0.1.0",
  "identifier": "com.moxianbao.imai",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "IMAI办公助手",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../app.py": "backend/app.py",
      "../../imai": "backend/imai/",
      "../../imai.db": "backend/imai.db",
      "../../.env": "backend/.env",
      "../../requirements.txt": "backend/requirements.txt",
      "../src/msg_gateway.bundle.cjs": "backend/msg_gateway.bundle.cjs"
    },
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
